{
  "name": "@aeromaint/viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint src vite.config.ts",
    "test": "vitest run --passWithNoTests",
    "test:browser": "playwright test",
    "test:benchmark": "playwright test --config playwright.benchmark.config.ts",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@aeromaint/capture-sdk": "workspace:*",
    "@aeromaint/contracts": "workspace:*",
    "@aeromaint/observability": "workspace:*",
    "@aeromaint/playback-core": "workspace:*",
    "@aeromaint/timeline-renderer": "workspace:*",
    "@tanstack/react-query": "^5.83.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "vite": "^7.0.6"
  }
}
